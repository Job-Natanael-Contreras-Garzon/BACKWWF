# ==============================================================================
# Plantilla de Variables de Entorno - BACKWWF
# Nunca subas un archivo .env real ni secretos reales a Git.
# ==============================================================================

PROJECT_NAME="Fauna Monitoring API"
API_V1_STR="/api/v1"

# Perfil activo: "development" | "production"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# Perfil DEVELOPMENT (copia a .env local y ajusta si es necesario)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:dev_password_placeholder@host.docker.internal:5433/faunadb"

# Claves JWT (>= 32 bytes y distintas entre si)
SECRET_KEY="dev-access-secret-placeholder-min-32-bytes-long"
REFRESH_SECRET_KEY="dev-refresh-secret-placeholder-min-32-bytes-long"
ALGORITHM="HS256"

ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Límites públicos, carga y mapa (/api/v1/config/public)
MAX_FILE_MB=300
MAX_IMAGE_PIXELS=100000000
MAX_VIDEO_SECONDS=15
BROWSER_DURATION_CHECK_EXTENSIONS="mp4,mov,webm"
ANON_MAX_FILES=50
ANON_MAX_CAMERAS=5
# Sesiones anónimas temporales (HU-05): TTL deslizante y límite por IP
ANON_SESSION_TTL_HOURS=24
ANON_SESSION_RATE_LIMIT_PER_HOUR=5
UPLOAD_MAX_PARALLEL_FILES=3
QUEUE_MAX_PENDING_PER_USER=500
UPLOAD_POLL_INTERVAL_SECONDS=3
IMPORT_MAX_MB=200
MAP_DEFAULT_CENTER_LAT=-17.7833
MAP_DEFAULT_CENTER_LNG=-63.1821
MAP_DEFAULT_ZOOM=8
MAP_DEFAULT_LABEL="Santa Cruz, Bolivia"
MAP_PAGE_SIZE_MAX=2000
# Lotes y cola (HU-08). En Docker, REDIS_URL lo fija docker-compose (redis://redis:6379/0).
REDIS_URL="redis://localhost:6379/0"
TMP_UPLOAD_PATH="/code/uploads/tmp"
TMP_DISK_MAX_USAGE=0.85
UPLOAD_CHUNK_BYTES=1048576
FFPROBE_TIMEOUT_SECONDS=20
QUEUE_PER_OWNER_INFLIGHT=2
QUEUE_MAX_GLOBAL=5000
QUEUE_AVG_PROCESSING_SECONDS=20
QUEUE_WORKERS=1
BATCH_RECENT_MINUTES=10
# Reaper (FL-33, cada 5 min) y limpieza (FL-31, cada hora)
TMP_UPLOAD_TTL_HOURS=24
TMP_ORPHAN_MINUTES=60
REAPER_HEARTBEAT_MINUTES=10
REAPER_MAX_ATTEMPTS=3
BATCH_IDLE_CLOSE_MINUTES=60
# Worker arq (HU-11): `arq app.worker.main.WorkerSettings` (servicio "worker" del compose)
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_SECONDS=30
WORKER_RETRY_DELAYS="5,30"
EVIDENCE_MAX_PX=960
# Ráfagas (HU-12): minutos entre registros del mismo animal para sugerir que se repiten.
BURST_WINDOW_MINUTES=5
EVIDENCE_JPEG_QUALITY=80
# Cámaras (HU-06): radio de "cercanas", aviso al mover y caja para detectar lat/lng invertidas (no limita)
NEARBY_RADIUS_M=30
NEARBY_MAX_RADIUS_M=200
CAMERA_MOVE_WARNING_M=50
REGION_BBOX="-69.65,-22.91,-57.45,-9.67"

# Recuperación de contraseña por correo (HU-04). Apagada hasta tener dominio verificado en Resend.
# En producción con PASSWORD_RECOVERY_ENABLED=true exige EMAIL_PROVIDER=resend, RESEND_API_KEY,
# EMAIL_FROM y FRONTEND_BASE_URL https. "console" (solo desarrollo) escribe el correo en DEV_MAILBOX_PATH.
#
# Probar Resend en DESARROLLO (sin dominio verificado): EMAIL_PROVIDER="resend",
# EMAIL_FROM="onboarding@resend.dev" y PASSWORD_RECOVERY_ENABLED=true. Con ese remitente Resend
# solo entrega al correo dueño de la cuenta de Resend: registra el usuario de prueba con ese correo.
# Verificar: python -m app.cli send-test-email --to <correo-de-la-cuenta-resend>
PASSWORD_RECOVERY_ENABLED=false
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_API_URL="https://api.resend.com/emails"
EMAIL_FROM=""
EMAIL_TIMEOUT_SECONDS=10
FRONTEND_BASE_URL="http://localhost:5173"
DEV_MAILBOX_PATH="/code/uploads/dev-mailbox"
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_DAILY_CAP=80
EMAIL_MONTHLY_CAP=2500
PASSWORD_FORGOT_EMAIL_PER_HOUR=3
PASSWORD_FORGOT_EMAIL_PER_DAY=5
PASSWORD_FORGOT_IP_PER_HOUR=10
# Por encima de esto, 429 RATE_LIMITED (abuso evidente); por debajo, los límites son silenciosos.
PASSWORD_FORGOT_IP_ABUSE_PER_HOUR=30

# Servicio IA (ia-clasificacion-fauna o ia-fake en :8001). AI_SERVICE_URL va SIN /api/v1.
# AI_API_KEY debe ser igual a la de la IA (dev-key en desarrollo).
# AI_TIMEOUT_SECONDS debe ser mayor que PROCESS_TIMEOUT_SECONDS de la IA (150).
AI_SERVICE_URL="http://host.docker.internal:8001"
AI_API_KEY="dev-key"
AI_TIMEOUT_SECONDS=180
# Catálogo SpeciesNet (HU-13): copia incluida en el repo. `python -m app.cli sync-catalog` lo
# actualiza desde la IA; en Docker conviene apuntarlo a un volumen escribible.
CATALOG_PATH=app/data/speciesnet_catalog.json
VISUALCROSSING_API_KEY=""

# Logs JSON a stdout y versión que aparece en cada línea de log
LOG_LEVEL="INFO"
APP_VERSION="dev"

# Fotogramas de evidencia: en Docker local va dentro del volumen ./uploads
STORAGE_LOCAL_PATH="/code/uploads/evidence"

# CORS en desarrollo (en local tambien se habilita localhost:5173 y 3000)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ------------------------------------------------------------------------------
# Perfil PRODUCTION (inyectar en variables secretas del PaaS, sin archivo .env)
# ------------------------------------------------------------------------------
# ENVIRONMENT="production"
# DATABASE_URL="postgresql+asyncpg://user:password@prod-db-host:25060/faunadb?ssl=require"
# SECRET_KEY="<generar-clave-criptografica-unica-min-32-bytes>"
# REFRESH_SECRET_KEY="<generar-clave-criptografica-distinta-min-32-bytes>"
# AI_SERVICE_URL="http://ia:8001"
# AI_API_KEY="<api-key-ia-produccion-misma-que-la-ia>"
# AI_TIMEOUT_SECONDS=180
# VISUALCROSSING_API_KEY="<api-key-clima-si-aplica>"
# ALLOWED_ORIGINS="https://app.wwf.org"
